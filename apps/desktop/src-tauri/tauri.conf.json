{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "景明研环",
  "version": "0.2.5",
  "identifier": "com.jingming.yanhuan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @jingming/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @jingming/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "景明研环",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/opencode",
      "binaries/uv",
      "binaries/agent-browser"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../runtime/goal-plugin": "goal-plugin/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/harness": "harness/",
      "../../../runtime/qoder-sidecar": "qoder-sidecar/",
      "../../../examples/climate-trends": "examples/climate-trends/",
      "../../../runtime/skills/external/jingming-skills": "skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}