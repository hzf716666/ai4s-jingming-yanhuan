{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "景明研环",
  "version": "0.1.0",
  "identifier": "com.jingming.yanhuan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @jingming/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "景明研环",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "x": 240,
        "y": 90,
        "visible": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/opencode",
      "binaries/uv",
      "binaries/agent-browser"
    ],
    "resources": {
      "../../../runtime/goal-plugin": "goal-plugin/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/harness": "harness/",
      "../../../runtime/qoder-sidecar": "qoder-sidecar/",
      "../../../examples/climate-trends": "examples/climate-trends/",
      "../../../runtime/skills/external/jingming-skills": "skills/",
      "../../../runtime/skills/00-通用工具": "skills-00/",
      "../../../runtime/skills/01-文献调研": "skills-01/",
      "../../../runtime/skills/02-假设设计": "skills-02/",
      "../../../runtime/skills/03-数据工程": "skills-03/",
      "../../../runtime/skills/04-实验执行": "skills-04/",
      "../../../runtime/skills/05-分析验证": "skills-05/",
      "../../../runtime/skills/06-写作发表": "skills-06/",
      "../../../runtime/skills/07-领域科学": "skills-07/"
    }
  }
}