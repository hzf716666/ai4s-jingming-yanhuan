{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "景明研环",
  "version": "0.1.0",
  "identifier": "com.jingming.yanhuan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --port 5174 --strictPort",
    "beforeBuildCommand": "pnpm --filter @ai4s/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "景明研环",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "x": 240,
        "y": 90,
        "visible": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
        "binaries/opencode",
        "binaries/uv",
        "binaries/agent-browser",
        "binaries/whisper-cli"
      ],
    "resources": {
      "../../../runtime/goal-plugin": "goal-plugin/",
      "../../../runtime/skills/external/ai4s-skills": "skills/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/core": "skills-core/",
      "../../../runtime/harness": "harness/",
      "../../../examples/climate-trends": "examples/climate-trends/"
    }
  }
}