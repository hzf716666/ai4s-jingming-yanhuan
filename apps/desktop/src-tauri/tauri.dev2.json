{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "景明研环 2",
  "version": "0.2.5",
  "identifier": "com.jingming.yanhuan.dev2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @jingming/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "景明研环 (Instance 2)",
        "label": "main2",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 13,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}